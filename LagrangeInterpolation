import numpy as np
import matplotlib.pyplot as plt

# Given data points
x_points = np.array([1, 3, 5])
y_points = np.array([2, 10, 26])

# Lagrange interpolation function
def lagrange_interpolation(x, x_points, y_points):

    n = len(x_points)
    result = 0

    for i in range(n):

        term = y_points[i]

        for j in range(n):
            if j != i:
                term *= (x - x_points[j]) / (x_points[i] - x_points[j])

        result += term

    return result


# Generate x values for smooth curve
x_values = np.linspace(1, 5, 200)
# Calculate interpolated y values
y_values = []

for x in x_values:
    y = lagrange_interpolation(x, x_points, y_points)
    y_values.append(y)

# Plot interpolation curve
plt.plot(x_values, y_values, label='Lagrange Polynomial')

# Plot original points
plt.scatter(x_points, y_points, color='red', label='Data Points')

# Labels and title
plt.xlabel('x')
plt.ylabel('y')
plt.title('Lagrange Interpolation')

plt.legend()
plt.grid(True)

# Show plot
plt.show()
